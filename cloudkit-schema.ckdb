DEFINE SCHEMA

    RECORD TYPE AskArtifact (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        artifactID      STRING QUERYABLE,
        content         ASSET,
        description     STRING,
        filename        STRING,
        machineID       STRING QUERYABLE,
        mimeType        STRING,
        scriptID        STRING QUERYABLE,
        sizeBytes       INT64,
        taskID          STRING QUERYABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskTask (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        artifactCount   INT64,
        lastActivityAt  TIMESTAMP QUERYABLE SORTABLE,
        machineID       STRING QUERYABLE,
        messageCount    INT64,
        scriptIcon      STRING,
        scriptIconData  STRING,
        scriptID        STRING QUERYABLE,
        scriptName      STRING,
        status          STRING QUERYABLE,
        taskID          STRING QUERYABLE,
        title           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskTaskMessage (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        machineID       STRING QUERYABLE,
        messageID       STRING QUERYABLE,
        partsJSON       STRING,
        role            STRING,
        scriptID        STRING QUERYABLE,
        sequenceNumber  INT64 QUERYABLE SORTABLE,
        taskID          STRING QUERYABLE,
        timestamp       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Agent (
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        agentID              STRING,
        capabilityEnvKeys    LIST<STRING>,
        capabilityNetwork    INT64,
        capabilityReadPaths  LIST<STRING>,
        capabilitySubprocess INT64,
        capabilityWritePaths LIST<STRING>,
        icon                 STRING,
        machineID            STRING QUERYABLE,
        name                 STRING QUERYABLE SORTABLE,
        scriptName           STRING,
        timeout              INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskDevice (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deviceID        STRING QUERYABLE SEARCHABLE SORTABLE,
        deviceName      STRING QUERYABLE SEARCHABLE SORTABLE,
        lastSeen        TIMESTAMP QUERYABLE SORTABLE,
        machineID       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskEvent (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        body            STRING,
        eventID         STRING QUERYABLE,
        machineID       STRING QUERYABLE,
        options         LIST<STRING>,
        sessionID       STRING QUERYABLE,
        source          STRING,
        timestamp       TIMESTAMP QUERYABLE SORTABLE,
        title           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskMessage (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        fromDevice      STRING QUERYABLE,
        machineID       STRING QUERYABLE,
        messageID       STRING QUERYABLE,
        readAt          TIMESTAMP QUERYABLE SORTABLE,
        scriptID        STRING QUERYABLE SEARCHABLE SORTABLE,
        sessionID       STRING QUERYABLE SEARCHABLE SORTABLE,
        text            STRING,
        timestamp       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskResponse (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        choice          STRING,
        eventID         STRING QUERYABLE,
        machineID       STRING QUERYABLE,
        timestamp       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskSession (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        lastActivityAt  TIMESTAMP QUERYABLE SORTABLE,
        machineID       STRING QUERYABLE,
        sessionID       STRING QUERYABLE,
        startedAt       TIMESTAMP,
        status          STRING QUERYABLE,
        title           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AskTyping (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        fromDevice      STRING QUERYABLE,
        machineID       STRING QUERYABLE,
        timestamp       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE FeedSchedule (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        machineID       STRING QUERYABLE SEARCHABLE SORTABLE,
        schedule        STRING QUERYABLE SEARCHABLE SORTABLE,
        scriptID        STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Job (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        agentID         STRING QUERYABLE,
        completedAt     TIMESTAMP,
        createdAt       TIMESTAMP QUERYABLE SORTABLE,
        exitCode        INT64,
        jobID           STRING,
        machineID       STRING QUERYABLE,
        prompt          STRING,
        startedAt       TIMESTAMP,
        status          STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Machine (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        activeJobID     STRING,
        lastHeartbeat   TIMESTAMP QUERYABLE SORTABLE,
        machineID       STRING QUERYABLE SEARCHABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        platform        STRING QUERYABLE SEARCHABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE OutputChunk (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        isError         INT64,
        jobID           STRING QUERYABLE,
        sequence        INT64 QUERYABLE SORTABLE,
        text            STRING,
        timestamp       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RKBlock (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        blockID          STRING QUERYABLE,
        blockType        STRING QUERYABLE,
        createdAt        TIMESTAMP QUERYABLE SORTABLE,
        expiresAt        TIMESTAMP QUERYABLE SORTABLE,
        machineID        STRING QUERYABLE,
        payload          STRING,
        requiresResponse INT64 QUERYABLE SORTABLE,
        scriptID         STRING QUERYABLE,
        scriptIcon       STRING QUERYABLE SEARCHABLE SORTABLE,
        scriptIconData   STRING QUERYABLE SEARCHABLE SORTABLE,
        scriptIconSVG    STRING QUERYABLE SEARCHABLE SORTABLE,
        scriptName       STRING QUERYABLE SEARCHABLE SORTABLE,
        scriptType       STRING QUERYABLE SEARCHABLE SORTABLE,
        showsInInbox     INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RKResponse (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        blockID         STRING QUERYABLE,
        machineID       STRING QUERYABLE,
        scriptID        STRING QUERYABLE,
        timestamp       TIMESTAMP QUERYABLE SORTABLE,
        value           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

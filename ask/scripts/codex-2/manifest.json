{
  "id": "codex-2",
  "name": "Codex",
  "version": "1.7.11",
  "description": "Codex CLI session supervisor — uses terminal-manager for TUI detection",
  "entry": "main.py",
  "icon": "sparkles",
  "icon_file": "icon.svg",
  "tools": [
    {
      "name": "permission_request",
      "description": "Routes a Codex tool permission prompt to iPhone for approval. Blocks until approved or denied.",
      "params": [
        { "name": "tool",  "type": "string", "required": true },
        { "name": "input", "type": "object", "required": false }
      ]
    },
    {
      "name": "session_active",
      "description": "Registers or updates a Codex session. Called by hooks.",
      "params": [
        { "name": "session_id", "type": "string", "required": true },
        { "name": "cwd",        "type": "string", "required": true },
        { "name": "tty",        "type": "string", "required": false }
      ]
    },
    {
      "name": "session_stop",
      "description": "Marks a Codex session as ended.",
      "params": [
        { "name": "session_id",   "type": "string", "required": true },
        { "name": "cwd",          "type": "string", "required": false },
        { "name": "last_message", "type": "string", "required": false }
      ]
    },
    {
      "name": "notification",
      "description": "Pushes a transient alert to iPhone.",
      "params": [
        { "name": "title", "type": "string", "required": true },
        { "name": "body",  "type": "string", "required": false }
      ]
    },
    {
      "name": "tool_executed",
      "description": "Resolves any pending permission block for the given tool.",
      "params": [
        { "name": "tool", "type": "string", "required": true }
      ]
    },
    {
      "name": "start_session",
      "description": "Launch a Codex CLI session in tmux. Emits a repo picker when no repo_path given.",
      "params": [
        { "name": "repo_path", "type": "string", "required": false }
      ]
    },
    {
      "name": "reply",
      "description": "Send a text message to an active Codex session from iPhone.",
      "params": [
        { "name": "message",    "type": "string", "required": true },
        { "name": "session_id", "type": "string", "required": false }
      ]
    },
    {
      "name": "stop_session",
      "description": "Interrupt a running Codex session (sends C-c).",
      "params": [
        { "name": "session_id", "type": "string", "required": false }
      ]
    }
  ],
  "requires": [
    {
      "id": "tmux",
      "name": "tmux",
      "check": "test -f /opt/homebrew/bin/tmux || test -f /usr/local/bin/tmux || command -v tmux >/dev/null 2>&1",
      "install": "brew install tmux",
      "install_url": "https://github.com/tmux/tmux"
    },
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "check": "PATH=$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node/ 2>/dev/null | sort -V | tail -1)/bin:$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:$PATH command -v codex >/dev/null 2>&1",
      "install": "npm install -g @openai/codex",
      "install_url": "https://github.com/openai/codex"
    }
  ]
}

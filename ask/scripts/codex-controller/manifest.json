{
  "id": "codex-controller",
  "name": "Codex",
  "version": "1.16.1",
  "description": "Codex CLI session supervisor — routes permissions and notifications to iPhone",
  "entry": "main.py",
  "icon": "sparkles",
  "icon_file": "icon.svg",
  "requires": [
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "check": "PATH=\"$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\" codex --version 2>/dev/null",
      "install": "npm install -g @openai/codex",
      "install_url": "https://github.com/openai/codex"
    }
  ]
}

{
  "id": "brew-monitor",
  "name": "Homebrew",
  "version": "3.0",
  "description": "Checks for outdated Homebrew packages and lets you upgrade from iPhone",
  "entry": "main.sh",
  "icon": "shippingbox",
  "icon_file": "icon.svg",
  "permissions": ["shell"],
  "requires": [
    {
      "id": "brew",
      "name": "Homebrew",
      "check": "brew --version",
      "install_url": "https://brew.sh"
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>AskMac</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="app"/>
    </choices-outline>

    <!-- Required: the app itself -->
    <choice id="app"
            title="AskMac"
            description="The AskMac menu bar application. Installs to /Applications."
            enabled="false"
            start_selected="true">
        <pkg-ref id="com.kevinhill.askmac.app"/>
    </choice>

    <!-- Package references — versions substituted at build time -->
    <pkg-ref id="com.kevinhill.askmac.app"
             version="ASKMAC_VERSION"
             onConclusion="none">AskMac-app.pkg</pkg-ref>
</installer-gui-script>
